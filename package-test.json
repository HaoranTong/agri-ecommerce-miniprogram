{"name": "agri-ecommerce-test", "version": "1.0.0", "description": "测试配置和脚本", "scripts": {"test": "jest", "test:api": "newman run docs/postman/myshop-api-test-suite.postman_collection.json -e docs/postman/MyShop_Dev.postman_environment.json --reporters cli,junit --reporter-junit-export test-results/api-results.xml", "test:api:dev": "npm run test:api -- --environment dev", "test:api:prod": "npm run test:api -- --environment prod", "test:coverage": "jest --coverage", "test:watch": "jest --watch", "test:all": "npm run test:api && npm run test"}, "devDependencies": {"@types/jest": "^29.0.0", "jest": "^29.0.0", "newman": "^5.3.0", "typescript": "^4.8.0"}, "jest": {"testEnvironment": "node", "testMatch": ["**/src/**/__tests__/**/*.test.{js,ts,tsx}"], "collectCoverageFrom": ["src/**/*.{js,ts,tsx}", "!src/**/*.d.ts", "!src/**/__tests__/**/*"], "coverageDirectory": "coverage", "coverageReporters": ["text", "lcov", "html"], "verbose": true}}