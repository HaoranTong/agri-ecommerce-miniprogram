{
  "info": {
    "name": "MyShop API Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (WeChat Code)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{test_user_openid}}\"\n}"
            },
            "url": {
              "protocol": "https",
              "host": ["agri-ecommerce", "test"],
              "path": ["wp-json", "myshop", "v1", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "protocol": "https",
              "host": ["agri-ecommerce", "test"],
              "path": ["wp-json", "myshop", "v1", "user", "profile"]
            }
          },
          "response": []
        }
      ]
    },
