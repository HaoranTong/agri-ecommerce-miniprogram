        {
          "name": "List My Gift Cards",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "protocol": "https",
              "host": ["agri-ecommerce", "test"],
