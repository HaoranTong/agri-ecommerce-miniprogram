        {
          "name": "Purchase Gift Card",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"template_id\": {{gift_card_template_id}},\n  \"delivery_mode\": \"digital_share\"\n}"
            },
            "url": {
              "protocol": "https",
              "host": ["agri-ecommerce", "test"],
              "path": ["wp-json", "myshop", "v1", "gift-cards", "purchase"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"状态码为200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test(\"成功返回礼品卡号和密码\", function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('card_number');",
                  "  pm.expect(json.data).to.have.property('card_pin');",
                  "});",
                  "if (json && json.data) {",
                  "  pm.environment.set('card_number', json.data.card_number || '');",
                  "  pm.environment.set('card_pin', json.data.card_pin || '');",
                  "  pm.environment.set('gift_card_template_id', json.data.template ? json.data.template.id : pm.environment.get('gift_card_template_id'));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
