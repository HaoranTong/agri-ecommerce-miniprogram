{
  "info": {
    "name": "MyShop API Test Suite",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (WeChat Code)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{test_user_openid}}\"\n}"
            },
            "url": {
              "protocol": "https",
              "host": ["agri-ecommerce", "test"],
              "path": ["wp-json", "myshop", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码为200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('登录成功返回token', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('token');",
                  "});",
                  "if (json && json.data && json.data.token) {",
                  "  pm.environment.set('auth_token', 'Bearer ' + json.data.token);",
                  "  pm.environment.set('user_id', json.data.user_id || '');",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "protocol": "https",
              "host": ["agri-ecommerce", "test"],
              "path": ["wp-json", "myshop", "v1", "user", "profile"]
            }
          },
          "response": []
        }
      ]
