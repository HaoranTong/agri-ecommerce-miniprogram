    {
      "name": "Points",
      "item": [
        {
          "name": "Get Points Balance",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "protocol": "https",
