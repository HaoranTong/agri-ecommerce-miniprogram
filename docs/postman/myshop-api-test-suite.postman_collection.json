            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码为200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('返回积分数据', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('available');",
                  "});",
                  "if (json && json.data) {",
                  "  pm.environment.set('points_available', json.data.available || 0);",
                  "}",
                  "pm.environment.set('points_balance_after_spend', '');"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Points Ledger",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "protocol": "https",
              "host": ["agri-ecommerce", "test"],
              "path": ["wp-json", "myshop", "v1", "points", "ledger"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "20" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码为200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('返回积分流水数组', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(Array.isArray(json.data)).to.be.true;",
                  "});",
                  "if (json && Array.isArray(json.data) && json.data.length > 0) {",
                  "  const latest = json.data[0];",
                  "  pm.environment.set('points_last_entry_id', latest.id || '');",
                  "  pm.environment.set('points_last_entry_delta', latest.delta || '');",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Grant Points",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" },
              { "key": "X-MyShop-Admin-Key", "value": "{{admin_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": {{points_seed_amount}},\n  \"reason\": \"{{points_seed_reason}}\",\n  \"target_openid\": \"{{points_seed_target_openid}}\"\n}"
            },
            "url": {
              "protocol": "https",
              "host": ["agri-ecommerce", "test"],
              "path": ["wp-json", "myshop", "v1", "points", "grant"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('状态码为200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('发放成功', function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json.data).to.have.property('new_balance');",
                  "});",
                  "if (json && json.data) {",
                  "  pm.environment.set('points_last_granted', json.data.granted || 0);",
                  "  pm.environment.set('points_balance_after_grant', json.data.new_balance || 0);",
                  "  pm.environment.set('points_available', json.data.new_balance || 0);",
                  "}",
                  "pm.environment.set('points_balance_after_spend', '');"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Spend Points",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"points\": {{points_spend_amount}},\n  \"reason\": \"{{points_spend_reason}}\"\n}"
            },
            "url": {
              "protocol": "https",
              "host": ["agri-ecommerce", "test"],
              "path": ["wp-json", "myshop", "v1", "points", "spend"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.test('扣减成功', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data).to.have.property('new_balance');",
                  "  });",
                  "  pm.environment.set('points_balance_after_spend', json.data.new_balance || 0);",
                  "  pm.environment.set('points_available', json.data.new_balance || 0);",
                  "} else {",
                  "  const json = pm.response.json();",
                  "  pm.test('余额不足提示', function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "    pm.expect(json.code).to.be.oneOf(['insufficient_points','invalid_points']);",
                  "  });",
                  "}",
                  "pm.environment.set('points_last_spend_code', pm.response.code);"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
