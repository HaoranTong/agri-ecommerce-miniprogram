                  "const json = pm.response.json();",
                  "pm.test(\"返回礼品卡列表\", function () {",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(Array.isArray(json.data)).to.eql(true);",
                  "});",
                  "if (json && Array.isArray(json.data)) {",
                  "  const target = json.data.find(item => item.card_number === pm.environment.get('card_number'));",
                  "  if (target) {",
                  "    pm.environment.set('gift_card_last_known_status', target.status || '');",
                  "  }",
