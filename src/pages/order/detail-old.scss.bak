.order-detail-page {
  padding: 20px;
  min-height: 100vh;
  background: #f5f5f5;
}

.card {
  background: white;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.section-title {
  font-size: 36px;
  font-weight: bold;
  margin-bottom: 32px;
  color: #333;
  
  &.highlight-title {
    color: #ff5722;
    font-size: 40px;
    padding-bottom: 20px;
    margin-bottom: 48px;  // 增加"确认商品"标题下的间距
    border-bottom: 3px solid #ff5722;
  }
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 24px 0;  // 增加行间距
  border-bottom: 1px solid #f0f0f0;
  
  &:last-child {
    border-bottom: none;
  }
}

.checkout-item-block {
  margin-bottom: 24px;
  padding: 32px;
  background: #fafafa;
  border-radius: 16px;
  
  &:not(:last-child) {
    padding-bottom: 32px;
  }

  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;  // 增加内部行间距
    border-bottom: 1px dashed #e0e0e0;

    &:last-child {
      border-bottom: none;
    }

    &.highlight {
      background: linear-gradient(90deg, #fff5f0 0%, #ffe8e0 100%);
      margin: 12px -20px -20px;
      padding: 16px 20px;
      border-radius: 0 0 12px 12px;
    }

    .label {
      font-size: 26px;
      color: #666;
      font-weight: 500;
    }

    .value {
      font-size: 28px;
      color: #333;
      text-align: right;
      flex: 1;
      margin-left: 20px;

      &.price {
        color: #f44336;
        font-weight: 600;
      }

      &.subtotal {
        color: #ff5722;
        font-size: 32px;
        font-weight: 700;
      }
    }
  }
}

.divider {
  height: 1px;
  background: #e0e0e0;
  margin: 16px 0;
}

.subtotal {
  color: #e74c3c;
  font-weight: bold;
}

.status-text {
  color: #ff9800;
  font-weight: 600;
  font-size: 28px;
}

.amount {
  color: #ff5722;
  font-size: 32px;
  font-weight: 700;
}

.total-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  
  .total-row {
    border: none;
    color: white;
    font-size: 18px;
  }
  
  .total-label {
    font-weight: bold;
  }
  
  .total-value {
    font-size: 24px;
    font-weight: bold;
  }
}

.info-row.total {
  font-weight: bold;
  color: #e74c3c;
  padding-top: 16px;
  border-top: 1px solid #f0f0f0;
}

.product-description {
  color: #666;
  font-size: 28rpx;
  line-height: 1.6;
  margin-bottom: 16px;
}

.picker-value {
  color: #333;
}

// ✅ 支付说明样式优化
.payment-notice {
  background: #fff9f0;
  border-radius: 16px;
  padding: 36px;
  margin-bottom: 32px;
  border: 2px solid #ffe8cc;
}

.notice-title {
  font-size: 34px;
  font-weight: 600;
  color: #ff8c00;
  margin-bottom: 32px;  // 增加标题下间距
  padding-bottom: 20px;
  border-bottom: 1px dashed #ffd699;
  display: block;
}

.notice-list {
  display: flex;
  flex-direction: column;
  gap: 24px;  // 增加每条之间的间距
}

.notice-item {
  font-size: 28px;
  color: #666;
  line-height: 2.0;  // 增加行高
  padding-left: 10px;
  display: block;
}

// ✅ 按钮优化
.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 24px;
  padding: 0 30px 40px;
}

.pay-btn, .detail-btn {
  width: 100%;
  height: 88px !important;
  border-radius: 44px;
  font-size: 34px !important;
  font-weight: 600;
  border: none;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  
  &.primary {
    background: linear-gradient(135deg, #ff6b6b 0%, #ff8e53 100%);
    color: white;
    box-shadow: 0 8px 24px rgba(255, 107, 107, 0.5);
  }
}

.detail-btn {
  background: white;
  color: #666;
  border: 2px solid #e0e0e0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
}

/* 付款弹窗样式 */
.payment-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  justify-content: center;
  align-items: flex-end;
  z-index: 999;
}

.payment-modal-content {
  background: white;
  width: 90%;
  max-width: 400px;
  border-radius: 16px 16px 0 0;
  padding: 24px;
  margin-bottom: env(safe-area-inset-bottom);
}

.modal-title {
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  margin-bottom: 20px;
  color: #333;
}

.qr-section {
  display: flex;
  gap: 20px;
  margin-bottom: 20px;
}

.qr-item {
  flex: 1;
  text-align: center;
}

.qr-label {
  display: block;
  font-size: 14px;
  color: #666;
  margin-bottom: 8px;
}

.qr-code {
  width: 100%;
  height: 120px;
  border: 1px solid #eee;
  border-radius: 8px;
}

.order-info {
  background: #f9f9f9;
  padding: 16px;
  border-radius: 8px;
  margin-bottom: 20px;
  font-size: 14px;
  line-height: 1.6;
}

.order-id {
  font-weight: bold;
  color: #e74c3c;
}

.instruction {
  white-space: pre-line;
  color: #555;
}

.upload-btn {
  background: #e74c3c;
  color: white;
  border-radius: 8px;
  margin-bottom: 12px;
}

.close-btn {
  background: #f1f1f1;
  color: #666;
  border-radius: 8px;
}

/* 订单确认页面样式 */
.success-banner {
  background: linear-gradient(135deg, #ff9800 0%, #ff5722 100%);
  color: white;
  text-align: center;
  padding: 48px 30px;
  margin-bottom: 28px;
  border-radius: 16px;
  box-shadow: 0 6px 20px rgba(255, 87, 34, 0.3);

  .success-icon {
    font-size: 80px;
    display: block;
    margin-bottom: 20px;
  }

  .success-title {
    font-size: 36px;
    font-weight: bold;
    display: block;
    margin-bottom: 16px;
  }

  .success-subtitle {
    font-size: 26px;
    opacity: 0.95;
    display: block;
    line-height: 1.6;
  }
}

.info-row {
  .status-pending {
    color: #ff9800;
    font-weight: 600;
  }

  .amount {
    color: #e74c3c;
    font-size: 28px;
    font-weight: 700;
  }
}

.payment-notice {
  background: #fff9e6;
  border-left: 4px solid #ffc107;
  padding: 16px;
  margin-bottom: 20px;
  border-radius: 8px;

  .notice-title {
    font-size: 16px;
    font-weight: bold;
    color: #f57c00;
    display: block;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px dashed #ffd699;
  }

  .notice-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .notice-item {
    font-size: 14px;
    color: #666;
    line-height: 1.8;
    display: block;
    padding-left: 4px;
  }
}

/* ============================================
   支付确认页面（confirm.tsx）专用样式
   ============================================ */

.order-confirm-page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40px;
}

/* 页面标题 */
.order-confirm-page .page-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40px 32px;
  text-align: center;
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.25);
  
  .page-title {
    font-size: 40px;
    font-weight: bold;
    color: #ffffff;
    letter-spacing: 2px;
  }
}

/* 成功横幅 */
.order-confirm-page .success-banner {
  background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
  padding: 48px 32px;
  margin: 32px 24px;
  text-align: center;
  border-radius: 16px;
  border: 3px solid #ffb74d;
  box-shadow: 0 4px 16px rgba(255, 152, 0, 0.2);
  
  .success-icon {
    display: block;
    font-size: 72px;
    margin-bottom: 20px;
    animation: bounce 0.6s ease-in-out;
  }
  
  .success-title {
    display: block;
    font-size: 38px;
    font-weight: bold;
    color: #e65100;
    margin-bottom: 16px;
    letter-spacing: 2px;
  }
  
  .success-subtitle {
    display: block;
    font-size: 28px;
    color: #f57c00;
    line-height: 1.6;
  }
}

@keyframes bounce {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.1);
  }
}

/* 订单信息卡片 */
.order-confirm-page .order-info-card {
  background: white;
  padding: 40px 32px;
  margin: 0 24px 32px 24px;
  border-radius: 16px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  
  .card-title {
    display: block;
    font-size: 34px;
    font-weight: bold;
    color: #333;
    margin-bottom: 32px;
    padding-bottom: 20px;
    border-bottom: 2px solid #e8e8e8;
  }
  
  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 0;
    border-bottom: 1px dashed #f0f0f0;
    
    &:last-child {
      border-bottom: none;
    }
    
    &.total {
      margin-top: 20px;
      padding-top: 24px;
      border-top: 2px solid #e8e8e8;
      border-bottom: none;
      background: linear-gradient(to right, #fff5f5, #ffffff);
      padding: 24px 16px;
      margin: 20px -16px 0 -16px;
      border-radius: 8px;
    }
    
    .label {
      font-size: 30px;
      color: #666;
      font-weight: 500;
    }
    
    .value {
      font-size: 30px;
      color: #333;
      font-weight: 500;
      
      &.status-pending {
        color: #ff9800;
        font-weight: bold;
        font-size: 32px;
      }
      
      &.amount {
        font-size: 44px;
        color: #ff6b6b;
        font-weight: bold;
      }
    }
  }
}

/* 原有订单详情页卡片 */
.order-detail-page .card {
  background: #fff;
  margin-bottom: 32px;
  padding: 40px 32px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  border-radius: 16px;
  
  .section-title {
    display: block;
    font-size: 36px;
    font-weight: bold;
    color: #1a73e8;
    margin-bottom: 40px;
    padding-bottom: 20px;
    border-bottom: 3px solid #1a73e8;
    letter-spacing: 1px;
  }
  
  .info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid #f0f0f0;
    
    &:last-child {
      border-bottom: none;
    }
    
    &.total {
      margin-top: 16px;
      padding-top: 28px;
      border-top: 2px solid #e0e0e0;
      border-bottom: none;
    }
    
    .label {
      font-size: 28px;
      color: #666;
    }
    
    .value {
      font-size: 28px;
      color: #333;
      font-weight: 500;
      
      &.status-pending {
        color: #ff9800;
        font-weight: bold;
      }
      
      &.amount {
        font-size: 40px;
        color: #ff6b6b;
        font-weight: bold;
      }
    }
  }
}

/* 支付说明卡片 */
.order-confirm-page .payment-notice-card {
  background: linear-gradient(135deg, #fff9f0 0%, #fff5e6 100%);
  padding: 40px 32px;
  margin: 0 24px 40px 24px;
  border-radius: 16px;
  border: 3px solid #ffe0b2;
  box-shadow: 0 4px 16px rgba(255, 152, 0, 0.15);
  
  .card-title {
    display: block;
    font-size: 36px;
    font-weight: bold;
    color: #ff8c00;
    margin-bottom: 36px;
    padding-bottom: 20px;
    border-bottom: 2px solid #ffd699;
    letter-spacing: 2px;
  }
  
  .notice-content {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  
  .notice-step {
    display: flex;
    align-items: center;
    padding: 20px;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    
    .step-number {
      width: 52px;
      height: 52px;
      background: linear-gradient(135deg, #ff9800 0%, #ff6b6b 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 28px;
      font-weight: bold;
      flex-shrink: 0;
      margin-right: 20px;
    }
    
    .step-text {
      font-size: 30px;
      color: #333;
      line-height: 1.6;
      flex: 1;
    }
  }
}

/* 操作按钮组 */
.order-confirm-page .action-buttons {
  padding: 0 24px 40px 24px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  
  .primary-btn {
    width: 100%;
    height: 100px !important;
    background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%) !important;
    color: #fff !important;
    font-size: 38px !important;
    font-weight: bold !important;
    border-radius: 50px !important;
    border: none !important;
    box-shadow: 0 8px 24px rgba(255, 107, 107, 0.5) !important;
    letter-spacing: 4px !important;
    
    &::after {
      border: none;
    }
    
    &:active {
      opacity: 0.85;
      transform: scale(0.98);
    }
  }
  
  .secondary-btn {
    width: 100%;
    height: 88px !important;
    background: white !important;
    color: #666 !important;
    font-size: 32px !important;
    border-radius: 44px !important;
    border: 2px solid #e0e0e0 !important;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05) !important;
    
    &::after {
      border: none;
    }
    
    &:active {
      background: #f5f5f5 !important;
    }
  }
}

.empty-state {
  text-align: center;
  padding: 100px 20px;
  color: #999;
  font-size: 16px;
}